# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloudpulse
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/cloudpulse

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=10

# ── Alert Thresholds (%) ──────────────────────────────────────────────────────
CPU_ALERT_THRESHOLD=85
RAM_ALERT_THRESHOLD=85
DISK_ALERT_THRESHOLD=90

# ── AI Model ──────────────────────────────────────────────────────────────────
MODEL_CONTAMINATION=0.05
MODEL_RETRAIN_INTERVAL=3600

# ── Security ──────────────────────────────────────────────────────────────────
# Set a secret key to require agents to authenticate via X-Agent-Key header
# Leave empty to disable auth in development
AGENT_API_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true

# ── Agent ─────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
COLLECT_INTERVAL=5
TOP_PROCESSES=10
